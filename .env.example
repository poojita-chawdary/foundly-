# Spring Boot / Application
SPRING_PROFILES_ACTIVE=supabase,prod
SERVER_PORT=8080
COOKIE_SECURE=true
MEMBERSHIP_MODE=OPEN
UPLOAD_DIR=./data/images

# Supabase PostgreSQL (IPv4 Session Pooler)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<REGION_POOLER_HOST>:5432/postgres?sslmode=verify-full
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
SUPABASE_SSL_ROOT_CERT=backend/src/main/resources/prod-ca-2021.crt

# Supabase Project Metadata
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_REGION=ap-southeast-1

# Deployment URLs
BACKEND_URL=https://foundly-xoro.onrender.com
VERCEL_URL=https://foundly-alpha-ivory.vercel.app
